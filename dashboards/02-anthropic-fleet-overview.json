{
    "displayName": "Anthropic Models - Fleet Overview (All Models)",
    "dashboardFilters": [
        {
            "labelKey": "resource.label.\"model_user_id\"",
            "templateVariable": "model_id",
            "filterType": "RESOURCE_LABEL"
        }
    ],
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## 🚀 Anthropic Fleet Overview\nComprehensive view of all Anthropic models — token usage, request volumes, throughput, and input/output mix. Use the **model filter** to isolate a single model.",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#0D1B2A",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "yPos": 4,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Daily aggregations broken down by model",
                        "dividerBelow": true
                    },
                    "title": "📊 Daily Volume by Model"
                }
            },
            {
                "yPos": 8,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Daily tokens by model",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "86400s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "86400s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 8,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Daily requests by model",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "86400s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "86400s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 26,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Hourly resolution trends and input/output composition",
                        "dividerBelow": true
                    },
                    "title": "⏱️ Hourly Trends & Token Mix"
                }
            },
            {
                "yPos": 30,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Hourly token rate by model",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 30,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Input vs output token mix (all models, daily)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_AREA",
                                "minAlignmentPeriod": "86400s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "86400s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 46,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Aggregated throughput consumption across the fleet",
                        "dividerBelow": true
                    },
                    "title": "🔋 Throughput Consumption"
                }
            },
            {
                "yPos": 50,
                "width": 48,
                "height": 16,
                "widget": {
                    "title": "Throughput consumption by model (tokens/s equivalents)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_AREA",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/consumed_throughput\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        ]
    }
}