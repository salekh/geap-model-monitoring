                    "title": "\ud83d\udd11 24h Latency Percentile Scorecards (TTFT & E2E)",
                    "sectionHeader": {
                        "subtitle": "Fleet-wide latency benchmarks with yellow warning and red SLO violation thresholds",
                        "dividerBelow": true
                    }
                }
