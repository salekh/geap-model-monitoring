{
    "displayName": "Claude Fable 5 - Daily Token Usage",
    "labels": {
        "publisher": "anthropic",
        "platform": "vertex-ai",
        "suite": "geap-model-monitoring",
        "version": "v3-1-iter1",
        "dashboard-id": "01-fable5-token-usage"
    },
    "dashboardFilters": [
        {
            "labelKey": "resource.label.\"location\"",
            "templateVariable": "location",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "resource.label.\"model_version_id\"",
            "templateVariable": "model_version",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "metric.label.\"method\"",
            "templateVariable": "api_method",
            "filterType": "METRIC_LABEL"
        },
        {
            "labelKey": "metric.label.\"type\"",
            "templateVariable": "token_type",
            "filterType": "METRIC_LABEL"
        }
    ],
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "xPos": 0,
                "yPos": 0,
                "width": 48,
                "height": 5,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## \ud83e\udd8a Claude Fable 5 \u2014 Dedicated Token & Efficiency Monitor  `[v3.1-iter1]`\nGranular consumption, caching efficiency ratios, and hourly rate tracking for **claude-fable-5**.\n\n**Suite Navigation:** 00 Usage Summary | **[01 Fable 5 Deep-Dive]** | 02 Fleet Overview | 03 Latency & SLOs | 04 Errors & Reliability | 05 Caching & FinOps | 06 Capacity & Quota  \n*Interactive Filters active above: filter dynamically by Model, Region (`location`), Version (`model_version_id`), and API Method (`method`).*",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#1B1B3A",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 5,
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "\ud83d\udd11 Claude Fable 5 \u2014 24h Scorecards & Efficiency Ratios",
                    "sectionHeader": {
                        "subtitle": "Rolling 24-hour volume metrics paired with Cache Hit Ratio and Output/Input generation multiplier",
                        "dividerBelow": true
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 9,
                "width": 10,
                "height": 13,
                "widget": {
                    "title": "Total Fable 5 tokens (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\")",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        },
                        "thresholds": [
                            {
                                "value": 10000000,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": "High"
                            },
                            {
                                "value": 50000000,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": "Budget Alert"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 10,
                "yPos": 9,
                "width": 10,
                "height": 13,
                "widget": {
                    "title": "Output tokens (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\") metric.label.\"type\"=\"output\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 20,
                "yPos": 9,
                "width": 10,
                "height": 13,
                "widget": {
                    "title": "Uncached input tokens (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\") metric.label.\"type\"=\"input\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 30,
                "yPos": 9,
                "width": 9,
                "height": 13,
                "widget": {
                    "title": "Cache Hit Ratio (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\") metric.label.\"type\"=\"cache_read_input\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\") metric.label.\"type\"=monitoring.regex.full_match(\"input|cache_read_input|cache_write_input|cache_write_1h_input\")",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        },
                        "thresholds": [
                            {
                                "value": 0.5,
                                "color": "YELLOW",
                                "direction": "BELOW",
                                "label": "<50% Cache Hit"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 39,
                "yPos": 9,
                "width": 9,
                "height": 13,
                "widget": {
