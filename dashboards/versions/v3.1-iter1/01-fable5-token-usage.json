                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=monitoring.regex.full_match(\"claude-(fable|opus)-5.*\")",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
