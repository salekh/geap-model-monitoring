{
    "displayName": "Anthropic Models - Prompt Caching & Cost Efficiency",
    "labels": {
        "publisher": "anthropic",
        "platform": "vertex-ai",
        "suite": "geap-model-monitoring",
        "version": "v3-1-iter1",
        "dashboard-id": "05-caching-efficiency"
    },
    "dashboardFilters": [
        {
            "labelKey": "resource.label.\"model_user_id\"",
            "templateVariable": "model_id",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "resource.label.\"location\"",
            "templateVariable": "location",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "resource.label.\"model_version_id\"",
            "templateVariable": "model_version",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "metric.label.\"method\"",
            "templateVariable": "api_method",
            "filterType": "METRIC_LABEL"
        },
        {
            "labelKey": "metric.label.\"explicit_caching\"",
            "templateVariable": "explicit_caching",
            "filterType": "METRIC_LABEL"
        }
    ],
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "xPos": 0,
                "yPos": 0,
                "width": 48,
                "height": 5,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## \ud83d\udcb0 Prompt Caching & FinOps Cost Efficiency  `[v3.1-iter1]`\nMaximize prompt cache hits (`cache_read_input` @ ~0.1x cost) and monitor cache write overhead (`cache_write` @ 1.25x\u20132x cost).\n\n**Suite Navigation:** 00 Usage Summary | 01 Fable 5 Deep-Dive | 02 Fleet Overview | 03 Latency & SLOs | 04 Errors & Reliability | **[05 Caching & FinOps]** | 06 Capacity & Quota  \n*Interactive Filters active above: filter dynamically by Model, Region (`location`), Version (`model_version_id`), and API Method (`method`).*",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#0A2E1A",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 5,
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "\ud83d\udd11 24h Caching Scorecards & True Hit Ratios",
                    "sectionHeader": {
                        "subtitle": "Direct comparison of discounted cache reads vs full-price uncached input and cache write overhead",
                        "dividerBelow": true
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 9,
                "width": 12,
                "height": 13,
                "widget": {
                    "title": "\ud83d\udc9a Cache read tokens (24h) \u2014 90% discount",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=\"cache_read_input\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 12,
                "yPos": 9,
                "width": 12,
                "height": 13,
                "widget": {
                    "title": "\ud83d\udd34 Uncached input tokens (24h) \u2014 100% price",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=\"input\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        },
                        "thresholds": [
                            {
                                "value": 10000000,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": "High uncached"
                            },
                            {
                                "value": 50000000,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": "Very high"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 9,
                "width": 12,
                "height": 13,
                "widget": {
                    "title": "\ud83c\udfaf True Cache Hit Ratio (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=\"cache_read_input\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=monitoring.regex.full_match(\"input|cache_read_input|cache_write_input|cache_write_1h_input\")",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        },
                        "thresholds": [
                            {
                                "value": 0.5,
                                "color": "YELLOW",
                                "direction": "BELOW",
                                "label": "<50% Hit Rate"
                            },
                            {
                                "value": 0.2,
                                "color": "RED",
                                "direction": "BELOW",
                                "label": "Cache Broken"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 36,
                "yPos": 9,
                "width": 12,
                "height": 13,
                "widget": {
                    "title": "\u270d\ufe0f Cache Read-to-Write Ratio (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=\"cache_read_input\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=monitoring.regex.full_match(\"cache_write_input|cache_write_1h_input\")",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 22,
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "\ud83d\udcca Daily & Hourly Caching Breakdown",
                    "sectionHeader": {
                        "subtitle": "Input token volumes segmented by cache read, cache write (5m & 1h TTL), and uncached input",
                        "dividerBelow": true
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 26,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Daily input-side token breakdown (read vs write vs uncached)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "86400s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"!=\"output\"",
                                        "aggregation": {
                                            "alignmentPeriod": "86400s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 26,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Hourly cache_read vs uncached input tokens",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_AREA",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=monitoring.regex.full_match(\"input|cache_read_input\")",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"type\""
                                            ]
                                        }
                                    }
                                }
                            }
