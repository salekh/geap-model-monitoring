    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "xPos": 0,
                "yPos": 0,
                "width": 48,
                "height": 5,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## \ud83d\udee1\ufe0f Errors, Throttling & Reliability Triage  `[v3.1-iter1]`\nReal-time incident triage: HTTP response codes, error categories, 429 quota throttling, and normalized error ratios.\n\n**Suite Navigation:** 00 Usage Summary | 01 Fable 5 Deep-Dive | 02 Fleet Overview | 03 Latency & SLOs | **[04 Errors & Reliability]** | 05 Caching & FinOps | 06 Capacity & Quota  \n*Interactive Filters active above: filter dynamically by Model, Region (`location`), Version (`model_version_id`), and API Method (`method`).*",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#2A0A0A",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 5,
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "\ud83d\udd11 24h Reliability Scorecards & Error Ratios",
                    "sectionHeader": {
                        "subtitle": "Absolute counts paired with true Error Rate % and 429 Throttling Rate % ratios",
                        "dividerBelow": true
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 9,
                "width": 10,
                "height": 13,
                "widget": {
                    "title": "\u2705 Successful 200 OK (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"response_code\"=\"200\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 10,
                "yPos": 9,
                "width": 10,
                "height": 13,
                "widget": {
                    "title": "\u274c Failed requests non-200 (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"response_code\"!=\"200\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        },
                        "thresholds": [
                            {
                                "value": 10,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": "Failures present"
                            },
                            {
                                "value": 100,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": "High failures"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 20,
                "yPos": 9,
                "width": 9,
                "height": 13,
                "widget": {
                    "title": "Error Rate Ratio (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"response_code\"!=\"200\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
