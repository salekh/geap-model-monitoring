{
    "displayName": "Anthropic - Model Usage",
    "labels": {
        "publisher": "anthropic",
        "platform": "vertex-ai",
        "suite": "anthropic-model-monitoring",
        "version": "v3-1-iter1",
        "dashboard-id": "00-model-usage"
    },
    "dashboardFilters": [
        {
            "labelKey": "resource.label.\"model_user_id\"",
            "templateVariable": "model_id",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "resource.label.\"location\"",
            "templateVariable": "location",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "resource.label.\"model_version_id\"",
            "templateVariable": "model_version",
            "filterType": "RESOURCE_LABEL"
        },
        {
            "labelKey": "metric.label.\"method\"",
            "templateVariable": "api_method",
            "filterType": "METRIC_LABEL"
        }
    ],
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "xPos": 0,
                "yPos": 0,
                "width": 48,
                "height": 5,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## \ud83d\udcca Anthropic Model Usage Dashboard  `[v3.1-iter1]`\nExecutive summary of token consumption, request volumes, tokens/request efficiency, and error ratios across all Anthropic models.\n\n**Suite Navigation:** **[00 Usage Summary]** | 01 Fable 5 Deep-Dive | 02 Fleet Overview | 03 Latency & SLOs | 04 Errors & Reliability | 05 Caching & FinOps | 06 Capacity & Quota  \n*Interactive Filters active above: filter dynamically by Model, Region (`location`), Version (`model_version_id`), and API Method (`method`).*",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#1A1A2E",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 5,
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "\ud83d\udd11 Executive 24h Key Metrics & Ratios",
                    "sectionHeader": {
                        "subtitle": "Volume scorecards paired with normalized Tokens/Request and Error Rate ratios",
                        "dividerBelow": true
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "Total tokens (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        },
                        "thresholds": [
                            {
                                "value": 50000000,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": "High"
                            },
                            {
                                "value": 100000000,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": "Very high"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 8,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "Requests (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 16,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "Avg Tokens / Request (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "Output tokens (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"type\"=\"output\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_LINE"
                        }
                    }
                }
            },
            {
                "xPos": 32,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "\u26a0\ufe0f Errors non-200 (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"response_code\"!=\"200\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        },
                        "thresholds": [
                            {
                                "value": 10,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": "Present"
                            },
                            {
                                "value": 100,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": "High"
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 40,
                "yPos": 9,
                "width": 8,
                "height": 12,
                "widget": {
                    "title": "Error Rate Ratio (24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilterRatio": {
                                "numerator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" metric.label.\"response_code\"!=\"200\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                },
                                "denominator": {
                                    "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                    "aggregation": {
                                        "alignmentPeriod": "86400s",
                                        "perSeriesAligner": "ALIGN_SUM",
                                        "crossSeriesReducer": "REDUCE_SUM"
                                    }
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        },
                        "thresholds": [
                            {
                                "value": 0.01,
                                "color": "YELLOW",
                                "direction": "ABOVE",
                                "label": ">1% Errors"
                            },
                            {
                                "value": 0.05,
                                "color": "RED",
                                "direction": "ABOVE",
                                "label": ">5% Breach"
                            }
                        ]
                    }
                }
            },
            {
