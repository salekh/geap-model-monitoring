{
    "displayName": "Claude Fable 5 - Daily Token Usage",
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "width": 48,
                "height": 20,
                "widget": {
                    "title": "Tokens per day by type (input / output / cache)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "86400s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=\"claude-fable-5\"",
                                        "aggregation": {
                                            "alignmentPeriod": "86400s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 20,
                "width": 16,
                "height": 16,
                "widget": {
                    "title": "Total tokens (last 24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=\"claude-fable-5\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        }
                    }
                }
            },
            {
                "xPos": 16,
                "yPos": 20,
                "width": 16,
                "height": 16,
                "widget": {
                    "title": "Output tokens (last 24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=\"claude-fable-5\" metric.label.\"type\"=\"output\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        }
                    }
                }
            },
            {
                "xPos": 32,
                "yPos": 20,
                "width": 16,
                "height": 16,
                "widget": {
                    "title": "Input tokens (last 24h)",
                    "scorecard": {
                        "timeSeriesQuery": {
                            "timeSeriesFilter": {
                                "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=\"claude-fable-5\" metric.label.\"type\"=\"input\"",
                                "aggregation": {
                                    "alignmentPeriod": "86400s",
                                    "perSeriesAligner": "ALIGN_SUM",
                                    "crossSeriesReducer": "REDUCE_SUM"
                                }
                            }
                        },
                        "sparkChartView": {
                            "sparkChartType": "SPARK_BAR"
                        }
                    }
                }
            },
            {
                "yPos": 36,
                "width": 48,
                "height": 16,
                "widget": {
                    "title": "Token rate by type (1h resolution)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/token_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\" resource.label.\"model_user_id\"=\"claude-fable-5\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        ]
    }
}