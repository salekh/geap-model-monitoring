{
    "displayName": "Anthropic Models - Capacity, Quota & Request Shape",
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Requests by request type (shared vs provisioned/dedicated)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"request_type\"",
                                                "metric.label.\"shared_request_type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Requests by input token size bucket",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"input_token_size\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 18,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Requests by output token size bucket",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"output_token_size\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 18,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Consumed token throughput by model (hourly)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/consumed_token_throughput\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 34,
                "width": 48,
                "height": 16,
                "widget": {
                    "title": "Requests by API method (rawPredict / streamRawPredict)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"method\""
                                            ]
                                        }
                                    }
                                }
                            }
