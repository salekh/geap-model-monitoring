{
    "displayName": "Anthropic Models - Capacity, Quota & Request Shape",
    "dashboardFilters": [
        {
            "labelKey": "resource.label.\"model_user_id\"",
            "templateVariable": "model_id",
            "filterType": "RESOURCE_LABEL"
        }
    ],
    "mosaicLayout": {
        "columns": 48,
        "tiles": [
            {
                "width": 48,
                "height": 4,
                "widget": {
                    "title": "",
                    "text": {
                        "content": "## 🏗️ Capacity, Quota & Request Shape\nUnderstand your capacity posture — shared vs provisioned routing, request size distributions, throughput consumption, and API method usage patterns.",
                        "format": "MARKDOWN",
                        "style": {
                            "backgroundColor": "#1A2E0A",
                            "textColor": "#E0E0E0",
                            "fontSize": "FS_MEDIUM",
                            "padding": "P_MEDIUM",
                            "horizontalAlignment": "H_LEFT",
                            "verticalAlignment": "V_CENTER"
                        }
                    }
                }
            },
            {
                "yPos": 4,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Shared vs provisioned/dedicated request routing and input token size buckets",
                        "dividerBelow": true
                    },
                    "title": "📊 Request Routing & Input Size"
                }
            },
            {
                "yPos": 8,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Requests by request type (shared vs provisioned/dedicated)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"request_type\"",
                                                "metric.label.\"shared_request_type\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 8,
                "width": 24,
                "height": 18,
                "widget": {
                    "title": "Requests by input token size bucket",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"input_token_size\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 26,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Output token size distribution and consumed throughput per model",
                        "dividerBelow": true
                    },
                    "title": "📤 Output Size & Throughput"
                }
            },
            {
                "yPos": 30,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Requests by output token size bucket",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"output_token_size\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 24,
                "yPos": 30,
                "width": 24,
                "height": 16,
                "widget": {
                    "title": "Consumed token throughput by model (hourly)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_AREA",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/consumed_token_throughput\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.label.\"model_user_id\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "yPos": 46,
                "width": 48,
                "height": 4,
                "widget": {
                    "sectionHeader": {
                        "subtitle": "Breakdown by API method — rawPredict vs streamRawPredict",
                        "dividerBelow": true
                    },
                    "title": "🔌 API Method Usage"
                }
            },
            {
                "yPos": 50,
                "width": 48,
                "height": 16,
                "widget": {
                    "title": "Requests by API method (rawPredict / streamRawPredict)",
                    "xyChart": {
                        "chartOptions": {
                            "mode": "COLOR"
                        },
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "minAlignmentPeriod": "3600s",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"aiplatform.googleapis.com/publisher/online_serving/model_invocation_count\" resource.type=\"aiplatform.googleapis.com/PublisherModel\" resource.label.\"publisher\"=\"anthropic\"",
                                        "aggregation": {
                                            "alignmentPeriod": "3600s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "metric.label.\"method\""
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        ]
    }
}